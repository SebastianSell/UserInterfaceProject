<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.example.assigment2.controller.EditTaskController">

    <Label fx:id="editTitleLabel" style="-fx-font-size:20" text="Edit Task" />
   <Label fx:id="nameLabel" text="Task Name " />

    <TextField fx:id="taskNameField" promptText="Task Title" />
   <Label fx:id="difficultyLabel" text="Task Difficulty" />

    <ComboBox fx:id="difficultyBox" prefWidth="200" promptText="Task Difficulty" />
   <Label fx:id="memberLabel" text="Assign Task " />

    <TextField fx:id="memberField" promptText="Which Member Is Assigned This Task" />
   <Label fx:id="statusLabel" text="Task Status" />

    <ComboBox fx:id="statusBox" prefWidth="200" promptText="Current Status of the Task" />
   <Label fx:id="dueDateLabel" text="Due Date" />

    <DatePicker fx:id="dueDatePicker" prefWidth="200" promptText="Due Date" />
   <Label fx:id="notesLabel" text="Additional Notes" />

    <TextField fx:id="notesField" promptText="Notes" />

    <HBox alignment="CENTER" spacing="10">
        <Button onAction="#handleSave" text="Save" />
        <Button onAction="#handleCancel" text="Cancel" />
    </HBox>

</VBox>
