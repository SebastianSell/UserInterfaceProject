<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.example.assigment2.SignupController">

    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <Label fx:id="signupTitle" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Create Account" />
   <Label fx:id="usernameLabel" text="Username" />

    <TextField fx:id="usernameField" maxWidth="250" promptText="Username" />
   <Label fx:id="passwordLabel" text="Password" />

    <PasswordField fx:id="passwordField" maxWidth="250" promptText="Password" />
   <Label fx:id="confirmPasswordLabel" text="Re-enter Password" />

    <PasswordField fx:id="confirmPasswordField" maxWidth="250" promptText="Confirm Password" />

    <Button fx:id="signupButton" onAction="#handleSignup" prefWidth="200" text="Create Account" />

    <Button fx:id="backButton" onAction="#goBack" prefWidth="200" text="Back to Login" />

</VBox>
