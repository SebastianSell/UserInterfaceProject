<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.finalUI.controller.TaskController">
   <center>
      <TableView fx:id="tableView" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
            <TableColumn fx:id="taskNameColumn" prefWidth="75.0" text="%taskName" />
            <TableColumn fx:id="taskDifficultyColumn" prefWidth="75.0" text="%taskDifficulty" />
            <TableColumn fx:id="memberAssignedColumn" prefWidth="75.0" text="%assignedTo" />
            <TableColumn fx:id="statusColumn" prefWidth="75.0" text="%taskStatus" />
            <TableColumn fx:id="dueDateColumn" prefWidth="75.0" text="%dueDate" />
            <TableColumn fx:id="createdDateColumn" prefWidth="75.0" text="%createdDate" />
            <TableColumn fx:id="notesColumn" prefWidth="75.0" text="%notes" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <top>
       <VBox alignment="CENTER" spacing="5">
           <Label fx:id="tableTitleLabel" alignment="CENTER" style="-fx-font-size: 4em;" styleClass="title" text="%task" />

          <MenuBar fx:id="menuNav" BorderPane.alignment="CENTER">
            <menus>
                <Menu fx:id="fileMenu" text="%file">
                    <items>
                        <MenuItem fx:id="closeMenuItem" text="%closeApplication" />
                    </items>
                </Menu>

                <Menu fx:id="helpMenu" text="%help">
                    <items>
                        <MenuItem fx:id="aboutMenuItem" text="%about" />
                    </items>
                </Menu>


                <Menu fx:id="extraMenu" text="%extra">
                    <items>
                        <MenuItem fx:id="logoutMenuItem" onAction="#handleLogout" text="%logout" />
                    </items>
                </Menu>
                <Menu text="%Language">
                    <items>
                        <MenuItem onAction="#setEnglish" text="English" />
                        <MenuItem onAction="#setFrench" text="Français" />
                    </items>
                </Menu>
            </menus>
          </MenuBar>
       </VBox>
   </top>
   <bottom>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
             <Button fx:id="createButton" onAction="#handleCreate" text="%create" />
             <Button fx:id="updateButton" onAction="#handleUpdate" text="%update" />
             <Button fx:id="deleteButton" onAction="#handleDelete" text="%delete" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
