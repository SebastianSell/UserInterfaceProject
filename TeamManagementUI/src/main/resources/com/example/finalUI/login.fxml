<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.finalUI.controller.LoginController">

    <Label fx:id="loginTitleLabel" style="-fx-font-size:22" text="Login" />
   <Label fx:id="usernameLabel" text="Username" />

    <TextField fx:id="usernameField" promptText="Username" />
   <Label fx:id="passwordLabel" text="Password" />
    <PasswordField fx:id="passwordField" promptText="Password" />

    <Label fx:id="errorLabel" style="-fx-text-fill:red" />
   <HBox alignment="CENTER" spacing="10.0">
      <children>
      
          <Button fx:id="loginButton" onAction="#handleLogin" text="Login" />
         <Button fx:id="backButton" mnemonicParsing="false" text="Cancel" />
      </children>
   </HBox>




</VBox>
