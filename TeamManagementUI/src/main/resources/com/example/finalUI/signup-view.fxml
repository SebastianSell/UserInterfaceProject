<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.finalUI.controller.SignupController">

    <center>
        <VBox alignment="CENTER" spacing="20">

            <Label fx:id="signupTitle" styleClass="title" text="%title.signup" />

            <Label fx:id="formInstructionLabel"
                   text="Create an account by entering a username and password. Fields marked with * are required."
                   wrapText="true" />

            <GridPane alignment="CENTER" hgap="10" maxWidth="350" vgap="10">

                <Label fx:id="usernameLabel" text="%username" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="usernameField" promptText="%username" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label fx:id="passwordLabel" text="%password" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <PasswordField fx:id="passwordField" promptText="%password" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label fx:id="confirmPasswordLabel" text="%confirmPassword" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <PasswordField fx:id="confirmPasswordField" promptText="%confirmPassword" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label fx:id="errorLabel" style="-fx-text-fill:red"
                       GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2"/>

            </GridPane>

            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="signupButton" onAction="#handleSignup" text="%create" />
                <Button fx:id="backButton" onAction="#handleCancel" styleClass="secondary-button" text="%cancel" />
            </HBox>

        </VBox>
    </center>
</BorderPane>
