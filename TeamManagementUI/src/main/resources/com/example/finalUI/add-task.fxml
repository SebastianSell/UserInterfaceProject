<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.finalUI.controller.AddTaskController">

    <center>

        <VBox alignment="CENTER" spacing="20">

            <Label fx:id="createTitleLabel"
                   text="%title.addTask"
                   style="-fx-font-size:20"/>

            <GridPane alignment="CENTER"
                      hgap="10"
                      vgap="10"
                      maxWidth="400">

                <padding>
                    <Insets top="10" right="20" bottom="10" left="20"/>
                </padding>

                <Label fx:id="nameLabel"
                       labelFor="$taskNameField"
                       text="%taskName"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="taskNameField"
                           promptText="%taskName"
                           prefWidth="250"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label fx:id="difficultyLabel"
                       labelFor="$difficultyBox"
                       text="%taskDifficulty"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="difficultyBox"
                          promptText="%difficulty.prompt"
                          prefWidth="250"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"/>

                <Label fx:id="memberLabel"
                       text="%assignTask"
                       labelFor="$memberField"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="memberField"
                           promptText="%assignTask"
                           prefWidth="250"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

                <Label fx:id="statusLabel"
                       text="%taskStatus"
                       labelFor="$statusBox"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="statusBox"
                          promptText="%status.prompt"
                          prefWidth="250"
                          GridPane.rowIndex="3"
                          GridPane.columnIndex="1"/>

                <Label fx:id="dueDateLabel"
                       labelFor="$dueDatePicker"
                       text="%dueDate"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>

                <DatePicker fx:id="dueDatePicker"
                            prefWidth="250"
                            GridPane.rowIndex="4"
                            GridPane.columnIndex="1"/>

                <Label fx:id="errorLabel"
                       style="-fx-text-fill:red"
                       GridPane.rowIndex="5"
                       GridPane.columnIndex="0"
                       GridPane.columnSpan="2"/>

                <Label fx:id="notesLabel"
                       labelFor="$notesField"
                       text="%notes"
                       GridPane.rowIndex="6"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="notesField"
                           promptText="%notes"
                           prefWidth="250"
                           GridPane.rowIndex="6"
                           GridPane.columnIndex="1"/>

            </GridPane>

            <HBox alignment="CENTER" spacing="10">

                <Button fx:id="saveButton"
                        text="%create"
                        onAction="#handleSave"/>

                <Button fx:id="cancelButton"
                        text="%cancel"
                        onAction="#handleCancel"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>
