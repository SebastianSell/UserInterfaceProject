<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.finalUI.controller.EditTaskController">

    <center>

        <VBox alignment="CENTER" spacing="20">

            <Label fx:id="editTitleLabel"
                   text="Edit Task"
                   style="-fx-font-size:20"/>

            <GridPane alignment="CENTER"
                      hgap="10"
                      vgap="10"
                      maxWidth="400">

                <padding>
                    <Insets top="10" right="20" bottom="10" left="20"/>
                </padding>

                <Label text="Task Name"
                       labelFor="$taskNameField"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="taskNameField"
                           prefWidth="250"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Task Difficulty"
                       labelFor="$difficultyBox"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="difficultyBox"
                          prefWidth="250"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"/>

                <Label text="Assign Task"
                       labelFor="$memberField"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="memberField"
                           prefWidth="250"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

                <Label text="Task Status"
                       labelFor="$statusBox"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="statusBox"
                          prefWidth="250"
                          GridPane.rowIndex="3"
                          GridPane.columnIndex="1"/>

                <Label text="Due Date"
                       labelFor="$dueDatePicker"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>

                <DatePicker fx:id="dueDatePicker"
                            prefWidth="250"
                            GridPane.rowIndex="4"
                            GridPane.columnIndex="1"/>

                <Label fx:id="errorLabel"
                       style="-fx-text-fill:red"
                       GridPane.rowIndex="5"
                       GridPane.columnIndex="0"
                       GridPane.columnSpan="2"/>

                <Label text="Additional Notes"
                       labelFor="$notesField"
                       GridPane.rowIndex="6"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="notesField"
                           prefWidth="250"
                           GridPane.rowIndex="6"
                           GridPane.columnIndex="1"/>

            </GridPane>

            <HBox alignment="CENTER" spacing="10">

                <Button fx:id="saveTaskButton"
                        text="Save"
                        onAction="#handleSave"/>

                <Button fx:id="cancelButton"
                        text="Cancel"
                        onAction="#handleCancel"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>